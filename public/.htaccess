Options -Indexes
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Les URL d'assets portent ?v=<date du fichier> (Html::asset) : un cache d'un an reste sûr.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpe?g|png|webp|gif|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always unset X-Powered-By
</IfModule>
