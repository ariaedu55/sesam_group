APP_ENV=local
APP_DEBUG=0
# URL locale obligatoire : serveur PHP intégré, pas WAMP.
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sesam
DB_USER=
DB_PASSWORD=

# Compte staff local (seed). Pas d'inscription publique.
SESAM_STAFF_EMAIL=
SESAM_STAFF_PASSWORD=

# NabooPay (provisoire : laisser vide = bac à sable local, pas d'appel API)
PAYMENT_GATEWAY=naboopay
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=
NABOOPAY_API_BASE=https://api.naboopay.com
NABOOPAY_SIGNATURE_HEADER=X-Signature
# 1 = appels API réels (Wave / Orange Money). 0 = bac à sable local SESAM.
NABOOPAY_LIVE=0
# Optionnel : chemin vers cacert.pem si PHP/cURL n'a pas de CA (Windows/WAMP).
# NABOOPAY_CA_BUNDLE=storage/certs/cacert.pem
PAYMENT_GATEWAY=naboopay

# WhatsApp (mock par défaut : rien ne part réellement)
NOTIFICATIONS_MODE=mock
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Notifications push (Firebase Cloud Messaging) : PUSH_DRIVER=fcm pour envoyer, log pour seulement journaliser.
PUSH_DRIVER=log
FIREBASE_CREDENTIALS=storage/firebase/service-account.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Connexion / inscription Google via Firebase Auth (même projet que les push).
# 1 = bouton affiché si FIREBASE_API_KEY / projet sont renseignés. 0 = masqué (tests).
GOOGLE_SIGNIN=1

# E-mails : MAIL_DRIVER=smtp (réel), log (storage/logs/mail.log) ou off.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=SESAM
MAIL_REPLY_TO=
