+    border: 1.5px solid var(--sesam-line);
+    border-radius: var(--sesam-radius-lg);
+    background: var(--sesam-surface);
+    cursor: pointer;
+    transition: border-color 0.2s ease, box-shadow 0.2s ease;
+}
+
+.biz-choice[data-tone="emerald"] { --tone: var(--sesam-emerald); }
+.biz-choice[data-tone="electric"] { --tone: var(--sesam-electric); }
+.biz-choice[data-tone="amber"] { --tone: var(--sesam-amber); }
+
+.biz-choice input {
+    position: absolute;
+    opacity: 0;
+    pointer-events: none;
+}
+
+.biz-choice-icon {
