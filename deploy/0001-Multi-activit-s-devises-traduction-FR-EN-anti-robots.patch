+    place-items: center;
+    flex: none;
+    width: 2.4rem;
+    height: 2.4rem;
+    border-radius: 0.8rem;
+    background: color-mix(in srgb, var(--tone) 14%, #fff);
+    color: var(--tone);
+}
+
+.biz-choice-icon .ui-icon {
+    width: 1.25rem;
+    height: 1.25rem;
+}
+
+.biz-choice-text {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    min-width: 0;
+}
+
+.biz-choice-text small {
+    overflow: hidden;
+    color: var(--sesam-muted);
+    text-overflow: ellipsis;
